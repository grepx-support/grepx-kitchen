# Copied to .env by ./setup.sh — run.sh loads it for every service.
JWT_SECRET=change-me-to-a-long-random-string
# Encrypts stored secrets (passwords in transit, keys saved on the Integrations page) - keep it different from JWT_SECRET.
# Values sealed before this was set still open with JWT_SECRET.
SECRET_BOX_KEY=change-me-to-another-long-random-string
SITE_URL=http://localhost:8861
ORG_NAME="Kitchen Stock and Costing"
TIMEZONE=Asia/Singapore
NEXUS_HOST=127.0.0.1
NEXUS_PORT=7880
# Email (587 STARTTLS or 465 SSL) — leave SMTP_HOST empty to only log messages. Sent by notification-service
# (welcome for new staff, alerts). Can also be set on Admin > Integrations.
# Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=587 SMTP_USER=you@gmail.com SMTP_PASS=<16-letter App password> SMTP_FROM=you@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Twilio SMS / WhatsApp
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_SMS_FROM=
TWILIO_WHATSAPP_FROM=
# Media: local (data/uploads) or s3
MEDIA_STORAGE=local
# Grafana (scripts/run.sh monitor): admin password; GRAFANA_BIND=127.0.0.1 keeps it off the internet
GRAFANA_PASSWORD=change-me

# One Nexus login per service (scripts/run.sh nexus-accounts): each service's password is derived from this secret and
# the server refuses writes to a table from any service but its owner. Leave empty to keep one shared login.
NEXUS_SERVICE_SECRET=
